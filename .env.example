# Copy to .env. Keep keys on this computer; .env is excluded from Git.
# rules works without an API key. Select API planning in the UI when ready.
MURAL_API_KIND=responses
MURAL_API_BASE_URL=https://api.openai.com/v1
MURAL_API_MODEL=
MURAL_API_KEY=
MURAL_API_TIMEOUT=90
# For providers with /chat/completions: set MURAL_API_KIND=chat_completions
# Some compatible providers do not implement response_format.
MURAL_API_JSON_MODE=true

# Cloud image redraw (optional). Default host is xAI Grok Imagine.
# Keep the real key only in the untracked .env; leave this example blank.
MURAL_IMAGINE_PROVIDER=openai_json
MURAL_IMAGINE_BASE_URL=https://api.x.ai/v1
MURAL_IMAGINE_MODEL=grok-imagine-image-2.0
MURAL_IMAGINE_API_KEY=
MURAL_IMAGINE_TIMEOUT=180

# A trusted TorchScript LaMa checkpoint. Run scripts/download_lama.py first.
MURAL_LAMA_MODEL=models/big-lama.pt
MURAL_DEVICE=auto
MURAL_LAMA_MAX_SIDE=1024
MURAL_DATA_DIR=data

